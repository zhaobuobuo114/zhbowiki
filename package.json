{
  "name": "zhbo-wiki",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base=/zhbowiki/ --outDir=docs && node scripts/gen-pages.mjs docs",
